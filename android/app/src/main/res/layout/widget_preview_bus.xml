<?xml version="1.0" encoding="utf-8"?>
<!-- The Ride alarm widget as the widget picker shows it (Android 12+), as BusWidget draws it ready to start. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_button"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_preview_bus_icon" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_on_bus"
        android:textColor="@color/widget_on_accent"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
