<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".SamFranApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Google Maps, for the map of the bus stop; empty without a key (app/build.gradle.kts). -->
        <meta-data android:name="com.google.android.geo.API_KEY" android:value="${mapsKey}" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- <package>://auth?code=… (Google sign-in coming back from the browser), <package>://bus?start=1,
                 <package>://us and <package>://shifts (the app's own notifications and widgets). MainActivity routes them. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" />
            </intent-filter>

            <!-- Sharing a place from Google Maps (or any text) to SamFran opens Add a place. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <!-- The bus-stop alarm: a trip that watches the phone's position and buzzes near the stop. -->
        <service
            android:name=".BusTripService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver android:name=".StopBuzzReceiver" android:exported="false" />

        <!-- "Start bus alarm?" when a shift ends: its alarm, set again after the phone restarts. -->
        <receiver android:name=".ShiftPrompt" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Meal reminders based on shifts: rescheduled on boot or app update. -->
        <receiver android:name=".MealPrompt" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Looks for the other person's changes about every half hour, to notify about any a push missed (PushService). -->
        <service
            android:name=".ActivityJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Locked apps: the cover over a locked app, in its own task so it doesn't bring the
             rest of SamFran up, and left out of the recent apps. -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="${applicationId}.lock"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- Locked apps: watches which app is open, and covers a locked one. -->
        <service
            android:name=".LockWatcher"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Covers the apps the user chose to lock until their partner allows them to be opened. It reads which app is in the foreground (usage access) while the screen is on." />
        </service>

        <!-- Firebase Cloud Messaging: the other person asking to open a locked app, and answers. -->
        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Allow and Deny on the notification of the other person's asking. -->
        <receiver android:name=".LockAnswerReceiver" android:exported="false" />

        <!-- The watcher starts again after the phone restarts, or the app is updated. -->
        <receiver android:name=".LockBoot" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The home-screen widgets (widget/): the next shift, and the ride alarm in one tap. -->
        <receiver
            android:name=".widget.NextShiftWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_next_shift">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_shift" />
        </receiver>
        <receiver
            android:name=".widget.BusWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_bus">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bus" />
        </receiver>

        <!-- Lets the camera save a photo of the shift sheet into the app's cache (feature:shifts). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/files" />
        </provider>

        <!-- Keeps the language picked in the app (per-app language) on Android 12 and older;
             Android 13+ keeps it in the system's settings. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The bus-stop alarm: where the phone is during a trip (never sent anywhere),
         a foreground service while it runs, and a notification that vibrates. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 16's Live Updates: the ride's notification as a chip in the status bar. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Setting the shift-end alarm and the changes check again after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Locked apps: which app is open (usage access, granted by the person in Settings),
         covering it (display over other apps, likewise), and the watcher's foreground service. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Saving a place's photo to Pictures on Android 8 and 9; from 10 the app may add its own without asking. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Locked apps: the apps on the phone that open from the launcher, to choose one to lock. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
