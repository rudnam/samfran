<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".SamFranApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Google Maps, for the map of the bus stop; empty without a key (app/build.gradle.kts). -->
        <meta-data android:name="com.google.android.geo.API_KEY" android:value="${mapsKey}" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- <package>://auth?code=… (Google sign-in coming back from the browser), <package>://bus?start=1
                 and <package>://us (the app's own notifications). MainActivity routes them. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" />
            </intent-filter>

            <!-- Sharing a place from Google Maps (or any text) to SamFran opens Add a place. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <!-- The bus-stop alarm: a trip that watches the phone's position and buzzes near the stop. -->
        <service
            android:name=".BusTripService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver android:name=".StopBuzzReceiver" android:exported="false" />

        <!-- "Start bus alarm?" when a shift ends: its alarm, set again after the phone restarts. -->
        <receiver android:name=".ShiftPrompt" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Looks for the other person's changes about every half hour, to notify about them. -->
        <service
            android:name=".ActivityJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Lets the camera save a photo of the shift sheet into the app's cache (feature:shifts). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/files" />
        </provider>

        <!-- Keeps the language picked in the app (per-app language) on Android 12 and older;
             Android 13+ keeps it in the system's settings. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The bus-stop alarm: where the phone is during a trip (never sent anywhere),
         a foreground service while it runs, and a notification that vibrates. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 16's Live Updates: the ride's notification as a chip in the status bar. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Setting the shift-end alarm and the changes check again after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
