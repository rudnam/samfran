.env
*.sql.gz
/backups/

# Browser test deps and output (see verify.sh)
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/

# Frontend deps and build output (dist/.gitkeep stays so go:embed always has a folder)
web/node_modules/
web/dist/*
!web/dist/.gitkeep

# Android: generated build output and, above all, the signing key
android/**/build/
android/.gradle/
*.keystore
*.jks

# Claude Code: worktrees of parallel sessions, and personal settings
.claude/worktrees/
.claude/settings.local.json

# Android: generated build output and, above all, the signing key
android/**/build/
android/.gradle/
android/keystore/
*.keystore
*.jks
android/*.apk
android/*.aab

# The APK the server offers for download (ANDROID_APK). The folder itself is
# kept, so Docker doesn't create it as root when it mounts it.
/downloads/*
!/downloads/.gitkeep

# CI results fetched by ./ci-results.sh
/ci-results/

# Python bytecode
__pycache__/
*.pyc
